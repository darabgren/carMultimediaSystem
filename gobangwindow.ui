    icon-size: 24px;
}

#btn_give_up {
    background-color: #ffcc99;      /* 认输 - 浅橙 */
    qproperty-icon: url(:/images/gobang/btn_give_up.png);
    icon-size: 24px;
}

#btn_restart {
    background-color: #ccff99;      /* 重新开始 - 浅绿 */
    qproperty-icon: url(:/images/gobang/btn_restart.png);
    icon-size: 24px;
}

#btn_quit {
	background-color: rgba(255, 111, 97, 0.7);
    
    qproperty-icon: url(:/images/gobang/btn_quit.png);
    icon-size: 24px;
}

QPushButton:hover {
    border-color: #666;            /* 悬停时边框变深 */
    background-color: #eeeeee;     /* 悬停时背景变浅 */
}</string>
