}
#label_player{
	font-size:45px;
	font-weight:bold;
}
QPushButton {
    border: 2px solid #333;          /* 统一边框 */
    border-radius: 10px;            /* 圆角 */
    font-size: 16px;                /* 字体大小 */
    font-weight: bold;              /* 字体加粗 */
    margin: 8px;                    /* 按钮间距 */
}

#btn_take_back {
    background-color: #ffcccc;      /* 悔棋 - 浅红 */
    qproperty-icon: url(:/images/gobang/btn_take_back.png);
    icon-size: 24px;                /* 图标大小 */
}

#btn_request_draw {
    background-color: #ffffcc;      /* 求和 - 浅黄 */
