   <property name="styleSheet">
    <string notr="true">#centralwidget{
	background-color: qlineargradient(
    spread:pad, 
    x1:0, y1:0, x2:0, y2:1,  /* 垂直渐变方向 */
    stop:0 #789ABD,           /* 起始颜色（浅蓝色） */
    stop:1 #E1B698             /* 结束颜色（深灰色） */
);
}
/* 主容器透明 */
QTabWidget {
    background: transparent;
    border: none;
}
/* 标签页面板透明 */
QTabWidget::pane {
    border: 0;
    background: transparent;
    margin: 0;
}
/* 标签栏透明 */
QTabWidget::tab-bar {
    background: transparent;
    left: 5px; /* 调整标签栏位置 */
}
/* 单个标签页样式 */
QTabBar::tab {
    background: rgba(70, 70, 70, 150); /* 半透明灰色 */
    color: white;
    border: 1px solid rgba(100, 100, 100, 100);
    border-bottom: none;
    padding: 5px 15px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
/* 选中的标签页 */
QTabBar::tab:selected {
    background: rgba(120, 120, 120, 180); /* 更不透明的选中状态 */
    border-color: rgba(150, 150, 150, 150);
}
/* 标签页内容区域 */
QTabWidget &gt; QStackedWidget {
    background: transparent;
}
/* 确保所有子部件继承透明 */
QTabWidget QWidget {
    background: transparent;
}

/* 透明背景轨道 */
QSlider::groove:horizontal {
    background: transparent;
    height: 4px;  /* 进度条高度 */
}
/* 已进度部分颜色（示例橙色） */
QSlider::sub-page:horizontal {
    background: rgba(255, 123, 37, 0.5); 
    border-radius: 2px;
}
/* 未进度部分颜色（示例半透明灰） */
QSlider::add-page:horizontal {
    background: rgba(200, 200, 200, 50);
    border-radius: 2px;
}
/* 圆形滑块 */
QSlider::handle:horizontal {
    background: white;
    width: 10px;
    height: 10px;
    margin: -5px 0;  /* 垂直居中 */
    border-radius: 6px;
    border: 1px solid #E0E0E0;  /* 可选描边 */
}
/*退出样式*/
#btn_quit{
	border-image: url(:/images/music/btn_quit_normal.png);
}
#btn_quit:hover{
	border-image: url(:/images/music/btn_quit_hover.png);
}
/*添加文件*/
#btn_file{
	border-image: url(:/images/music/btn_file_normal.png);
}
#btn_file:hover{
	border-image: url(:/images/music/btn_file_hover.png);
}
/* 上一首 */
#btn_pre{
	border-image: url(:/images/music/btn_pre_normal.png);
}
#btn_pre:hover{
	border-image: url(:/images/music/btn_pre_hover.png);
}

/* 下一首 */
#btn_next{
	border-image: url(:/images/music/btn_next_normal.png);
}
#btn_next:hover{
	border-image: url(:/images/music/btn_next_hover.png);
}

/*声音*/
#btn_volume{
	border-image: url(:/images/music/btn_volume.png);
}

/*播放按钮*/
QPushButton#btn_play[mode='pause']{
   border-image: url(:/images/music/btn_pause_normal.png);
}
QPushButton#btn_play[mode='pause']:hover{  
   border-image: url(:/images/music/btn_pause_hover.png);
}

QPushButton#btn_play[mode='play']{
   border-image: url(:/images/music/btn_play_normal.png);
}
QPushButton#btn_play[mode='play']:hover{
   border-image: url(:/images/music/btn_play_hover.png);
}

/*声音图标*/
QPushButton#btn_volume[mode='unmute']{  
	border-image: url(:/images/music/btn_volume.png);
}
QPushButton#btn_volume[mode='mute']{  
	border-image: url(:/images/music/btn_mute.png);
}
#btn_fullScreen{
	border-image: url(:/images/music/fullScreen.png);
}
</string>
   </property>
